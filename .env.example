# FRONTEND (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# BACKEND (NestJS)
PORT=4000

# DATABASE (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:MAT_KHAU_CUA_MAY@localhost:5432/brewlite?schema=public"
# sửa MAT_KHAU_CUA_MAY = mật khẩu của postgres
# brewlite = tên database của bạn

# AUTHENTICATION (JWT)
JWT_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret